# Free key, no card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python -m spikes.check_gemini --list-models` to see the IDs your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_GROUNDING_MODEL=gemini-3.5-flash-lite
# Optional. Service API key from https://foursquare.com/developers (project Settings). No card needed.
# Without it, trips use labelled meal breaks instead of restaurants.
FOURSQUARE_API_KEY=
# The website allowed to call the API from a browser.
FRONTEND_ORIGIN=http://localhost:3000
